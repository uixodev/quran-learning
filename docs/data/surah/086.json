{"id":86,"ayahs":[{"n":1,"ar":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","tj":[[2,3,0],[3,4,1],[8,10,5],[16,17,0],[17,18,1],[24,25,7]],"ru":"Клянусь небом и ночным путником!","tr":"Wassamaaa'i wattaariq"},{"n":2,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","tj":[[3,6,5],[9,11,7],[13,15,3],[22,23,0],[23,24,1],[30,31,7]],"ru":"Откуда ты мог знать, что такое ночной путник?","tr":"Wa maaa adraaka mattaariq"},{"n":3,"ar":"ٱلنَّجۡمُ ٱلثَّاقِبُ","tj":[[1,2,1],[2,5,8],[5,7,7],[10,11,0],[11,12,1],[18,19,7]],"ru":"Это - звезда пронизывающая небеса своим светом.","tr":"Annajmus saaqib"},{"n":4,"ar":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ","tj":[[2,3,9],[14,16,12],[20,22,8]],"ru":"Нет души, при которой не было бы хранителя.","tr":"In kullu nafsil lammaa 'alaihaa haafiz"},{"n":5,"ar":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","tj":[[6,8,9],[12,13,0],[17,20,9],[20,21,3],[26,28,8],[34,35,7]],"ru":"Пусть посмотрит человек, из чего он создан.","tr":"Fal yanzuril insaanu mimma khuliq"},{"n":6,"ar":"خُلِقَ مِن مَّآءٖ دَافِقٖ","tj":[[11,13,11],[13,16,5],[16,18,9],[24,25,7]],"ru":"Он создан из изливающейся жидкости,","tr":"Khuliqa mim maaa'in daafiq"},{"n":7,"ar":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","tj":[[10,13,14],[21,22,0],[22,23,1],[33,34,0],[34,35,1],[39,41,5],[44,45,7]],"ru":"которая выходит между чреслами и грудными костями.","tr":"Yakhruju mim bainissulbi wat taraaa'ib"},{"n":8,"ar":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","tj":[[2,4,8],[7,8,3],[18,20,7],[23,25,3]],"ru":"Воистину, Он способен вернуть его.","tr":"Innahoo 'alaa raj'ihee laqaadir"},{"n":9,"ar":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","tj":[[9,11,7],[15,16,0],[16,17,1],[21,23,5]],"ru":"В тот день будут испытаны (или раскроются) тайны,","tr":"Yawma tublas saraaa'ir"},{"n":10,"ar":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","tj":[[10,11,3],[14,15,9],[24,25,11]],"ru":"и тогда не будет у него ни силы, ни помощника.","tr":"Famaa lahoo min quwwatinw wa laa naasir"},{"n":11,"ar":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","tj":[[2,3,0],[3,4,1],[8,10,5],[20,21,0],[21,22,1],[25,27,7]],"ru":"Клянусь небом возвращающим (возвращающим воду земле или возвращающим небесные тела, которые восходят с одной стороны и заходят в другой)!","tr":"Wassamaaa'i zaatir raj'"},{"n":12,"ar":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","tj":[[2,3,0],[18,19,0],[19,20,1],[23,25,7]],"ru":"Клянусь землей раскалываемой (при прорастании растений, или при выходе из земли воды, или при воскрешении мертвых)!","tr":"Wal ardi zaatis sad'"},{"n":13,"ar":"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","tj":[[2,4,8],[7,8,3],[15,17,9]],"ru":"Воистину, это - Слово различающее,","tr":"Innahoo laqawlun fasl"},{"n":14,"ar":"وَمَا هُوَ بِٱلۡهَزۡلِ","tj":[[13,14,0]],"ru":"а не шутка.","tr":"Wa maa huwa bil hazl"},{"n":15,"ar":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا","tj":[[2,4,8]],"ru":"Они замышляют козни,","tr":"Innahum yakeedoona kaidaa"},{"n":16,"ar":"وَأَكِيدُ كَيۡدٗا","tj":[],"ru":"и Я замышляю козни.","tr":"Wa akeedu kaidaa"},{"n":17,"ar":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","tj":[[10,11,0],[15,16,3]],"ru":"Предоставь же неверующим отсрочку, помедли с ними недолго!","tr":"Famahhilil kaafireena amhilhum ruwaidaa"}]}
