{"id":114,"ayahs":[{"n":1,"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","tj":[[21,22,0],[22,23,1],[23,25,8],[25,27,4]],"ru":"Скажи: «Прибегаю к защите Господа людей,","tr":"Qul a'uzu birabbin naas"},{"n":2,"ar":"مَلِكِ ٱلنَّاسِ","tj":[[7,8,0],[8,9,1],[9,11,8],[11,13,4]],"ru":"Царя людей,","tr":"Malikin naas"},{"n":3,"ar":"إِلَٰهِ ٱلنَّاسِ","tj":[[4,5,3],[8,9,0],[9,10,1],[10,12,8],[12,14,4]],"ru":"Бога людей,","tr":"Ilaahin naas"},{"n":4,"ar":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","tj":[[2,3,9],[10,11,0],[23,24,0],[28,30,8],[30,32,4]],"ru":"от зла искусителя отступающего (или сжимающегося) при поминании Аллаха,","tr":"Min sharril was waasil khannaas"},{"n":5,"ar":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","tj":[[31,32,0],[32,33,1],[33,35,8],[35,37,4]],"ru":"который наущает в груди людей","tr":"Al lazee yuwas wisu fee sudoorin naas"},{"n":6,"ar":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","tj":[[5,6,0],[10,12,8],[18,19,0],[19,20,1],[20,22,8],[22,24,4]],"ru":"и бывает из джиннов и людей».","tr":"Minal jinnati wan naas"}]}
