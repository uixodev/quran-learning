{"id":87,"ayahs":[{"n":1,"ar":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","tj":[[8,9,0],[22,23,0]],"ru":"Славь имя Господа твоего Всевышнего,","tr":"Sabbihisma Rabbikal A'laa"},{"n":2,"ar":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","tj":[],"ru":"Который сотворил все сущее и всему придал соразмерность,","tr":"Allazee khalaqa fasawwaa"},{"n":3,"ar":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","tj":[[2,3,0]],"ru":"Который предопределил судьбу творений и указал путь,","tr":"Wallazee qaddara fahadaa"},{"n":4,"ar":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","tj":[[2,3,0],[7,10,5],[20,21,0]],"ru":"Который взрастил пастбища,","tr":"Wallazeee akhrajal mar'aa"},{"n":5,"ar":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","tj":[[10,11,3],[15,17,5]],"ru":"а потом превратил их в темный сор.","tr":"Faja'alahoo ghusaaa'an ahwaa"},{"n":6,"ar":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","tj":[[4,6,7],[21,23,9]],"ru":"Мы позволим тебе прочесть Коран, и ты не забудешь ничего,","tr":"Sanuqri'uka falaa tansaaa"},{"n":7,"ar":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","tj":[[12,14,5],[18,19,0],[29,31,8],[34,35,3],[45,46,0]],"ru":"кроме того, что пожелает Аллах. Он знает явное и то, что сокрыто.","tr":"Illaa maa shaaa'al laah; innahoo ya'lamul jahra wa maa yakhfaa"},{"n":8,"ar":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","tj":[],"ru":"Мы облегчим тебе путь к легчайшему.","tr":"Wa nu-yassiruka lilyusraa"},{"n":9,"ar":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","tj":[[14,15,11],[24,25,0],[25,26,1]],"ru":"Наставляй же людей, если напоминание принесет пользу.","tr":"Fazakkir in nafa'atizzikraa"},{"n":10,"ar":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","tj":[[17,18,11]],"ru":"Воспримет его тот, кто страшится,","tr":"Sa yazzakkaru maiyakhshaa"},{"n":11,"ar":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","tj":[[8,10,8],[17,18,0]],"ru":"и уклонится от него самый несчастный,","tr":"Wa yatajannabuhal ashqaa"},{"n":12,"ar":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","tj":[[16,17,0],[17,18,1],[18,20,8],[25,26,0],[30,32,7]],"ru":"который войдет в Огонь величайший.","tr":"Allazee yaslan Naaral kubraa"},{"n":13,"ar":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","tj":[[2,4,8]],"ru":"Не умрет он там и не будет жить.","tr":"Summa laa yamootu feehaa wa laa yahyaa"},{"n":14,"ar":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","tj":[[2,4,7],[16,17,9]],"ru":"Преуспел тот, кто очистился,","tr":"Qad aflaha man tazakkaa"},{"n":15,"ar":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","tj":[[9,10,0],[21,23,3]],"ru":"поминал имя своего Господа и совершал намаз.","tr":"Wa zakaras ma Rabbihee fasallaa"},{"n":16,"ar":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","tj":[[17,18,0],[24,25,2],[25,26,3],[29,30,0],[30,31,1]],"ru":"Но нет! Вы отдаете предпочтение мирской жизни,","tr":"Bal tu'siroonal hayaatad dunyaa"},{"n":17,"ar":"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","tj":[[2,3,0],[21,22,11],[25,27,7]],"ru":"хотя Последняя жизнь - лучше и дольше.","tr":"Wal Aakhiratu khairunw wa abqaa"},{"n":18,"ar":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","tj":[[2,4,8],[8,9,3],[19,20,0],[20,21,1],[29,30,0]],"ru":"Воистину, это записано в первых свитках -","tr":"Inna haazaa lafis suhu fil oolaa"},{"n":19,"ar":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","tj":[[9,11,7],[12,14,3]],"ru":"свитках Ибрахима (Авраама) и Мусы (Моисея).","tr":"Suhufi Ibraaheema wa Moosaa"}]}
