{"id":94,"ayahs":[{"n":1,"ar":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","tj":[[23,25,7]],"ru":"Разве Мы не раскрыли для тебя грудь твою?","tr":"Alam nashrah laka sadrak"},{"n":2,"ar":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","tj":[[14,16,9]],"ru":"и не сняли с тебя ношу,","tr":"Wa wa d'ana 'anka wizrak"},{"n":3,"ar":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","tj":[[5,8,5],[11,13,9]],"ru":"которая отягощала твою спину?","tr":"Allazee anqada zahrak"},{"n":4,"ar":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","tj":[],"ru":"Разве Мы не возвеличили для тебя славу твою?","tr":"Wa raf 'ana laka zikrak"},{"n":5,"ar":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","tj":[[4,6,8],[13,14,0]],"ru":"Воистину, за каждой тягостью наступает облегчение.","tr":"Fa inna ma'al usri yusra"},{"n":6,"ar":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","tj":[[2,4,8],[11,12,0]],"ru":"За каждой тягостью наступает облегчение.","tr":"Inna ma'al 'usri yusra"},{"n":7,"ar":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","tj":[[19,20,0],[20,23,9],[23,25,7]],"ru":"Посему, как только освободишься, будь деятелен (как только освободишься от мирских дел, усердно поклоняйся Аллаху, или как только завершишь намаз, усердно взывай к Аллаху с молитвами)","tr":"Fa iza faragh ta fansab"},{"n":8,"ar":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","tj":[[19,20,0],[24,25,7]],"ru":"и устремись к своему Господу.","tr":"Wa ilaa rabbika far ghab"}]}
