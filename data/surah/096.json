{"id":96,"ayahs":[{"n":1,"ar":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","tj":[[1,3,7],[10,11,0],[24,25,0],[36,37,7]],"ru":"Читай во имя твоего Господа, Который сотворил все сущее,","tr":"Iqra bismi rab bikal lazee khalaq"},{"n":2,"ar":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","tj":[[7,8,0],[12,15,9],[15,16,3],[28,29,7]],"ru":"сотворил человека из сгустка крови.","tr":"Khalaqal insaana min 'alaq"},{"n":3,"ar":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","tj":[[1,3,7],[18,19,0]],"ru":"Читай, ведь твой Господь - Самый великодушный.","tr":"Iqra wa rab bukal akram"},{"n":4,"ar":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","tj":[[18,19,0]],"ru":"Он научил посредством письменной трости -","tr":"Al lazee 'allama bil qalam"},{"n":5,"ar":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","tj":[[8,9,0],[13,16,9],[16,17,3]],"ru":"научил человека тому, чего тот не знал.","tr":"'Al lamal insaana ma lam y'alam"},{"n":6,"ar":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","tj":[[4,7,5],[10,12,8],[14,15,0],[19,22,9],[22,23,3],[30,32,7]],"ru":"Но нет! Человек преступает границы дозволенного,","tr":"Kallaa innal insaana layatghaa"},{"n":7,"ar":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","tj":[[1,3,12],[13,14,0]],"ru":"когда ему кажется, что он ни в чем не нуждается.","tr":"Ar-ra aahus taghnaa"},{"n":8,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","tj":[[2,4,8],[21,22,0],[22,23,1],[26,28,7]],"ru":"Но к твоему Господу предстоит возвращение.","tr":"Innna ilaa rabbikar ruj'aa"},{"n":9,"ar":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","tj":[[11,12,0]],"ru":"Что ты думаешь о том, кто мешает","tr":"Ara-aital lazee yanhaa"},{"n":10,"ar":"عَبۡدًا إِذَا صَلَّىٰٓ","tj":[[2,4,7]],"ru":"рабу, когда тот молится?","tr":"'Abdan iza sallaa"},{"n":11,"ar":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","tj":[[13,14,9],[27,28,0]],"ru":"Что ты думаешь, а если он был на правом пути","tr":"Ara-aita in kana 'alal hudaa"},{"n":12,"ar":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","tj":[[14,15,0],[15,16,1],[19,21,7]],"ru":"или призывал к богобоязненности?","tr":"Au amara bit taqwaa"},{"n":13,"ar":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","tj":[[13,14,9]],"ru":"Что ты думаешь, а если он счел ложью истину и отвернулся?","tr":"Ara-aita in kaz zaba wa ta walla"},{"n":14,"ar":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","tj":[[12,14,10],[19,21,8],[23,24,0]],"ru":"Неужели он не знал, что Аллах видит его?","tr":"Alam y'alam bi-an nal lahaa yaraa"},{"n":15,"ar":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","tj":[[10,12,12],[21,23,9],[36,39,14],[42,43,0],[43,44,1],[44,46,8]],"ru":"Но нет, если он не перестанет, то Мы схватим его за хохол -","tr":"Kalla la illam yantahi la nasfa'am bin nasiyah"},{"n":16,"ar":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ","tj":[[7,9,9],[12,13,3]],"ru":"хохол лживый, грешный.","tr":"Nasiyatin kazi batin khaatiyah"},{"n":17,"ar":"فَلۡيَدۡعُ نَادِيَهُۥ","tj":[[6,8,7]],"ru":"Пусть он зовет свое сборище.","tr":"Fal yad'u naadiyah"},{"n":18,"ar":"سَنَدۡعُ ٱلزَّبَانِيَةَ","tj":[[4,6,7],[9,10,0],[10,11,1]],"ru":"Мы же позовем адских стражей!","tr":"Sanad 'uz zabaaniyah"},{"n":19,"ar":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","tj":[[22,23,0],[27,29,7],[33,34,0],[34,36,7],[40,41,7]],"ru":"Так нет! Не повинуйся ему, а пади ниц и приближайся к Аллаху.","tr":"Kalla; la tuti'hu wasjud waqtarib"}]}
