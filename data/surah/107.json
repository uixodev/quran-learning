{"id":107,"ayahs":[{"n":1,"ar":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","tj":[[11,12,0],[31,32,0],[32,33,1],[35,37,4]],"ru":"Видел ли ты того, кто считает ложью воздаяние?","tr":"Ara-aital lazee yu kazzibu bid deen"},{"n":2,"ar":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","tj":[[3,5,3],[10,11,0],[26,27,0],[32,34,4]],"ru":"Это - тот, кто гонит сироту","tr":"Fa zaalikal lazi yadu'ul-yateem"},{"n":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","tj":[[29,30,0],[37,39,4]],"ru":"и не побуждает накормить бедняка.","tr":"Wa la ya huddu 'alaa ta'amil miskeen"},{"n":4,"ar":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","tj":[[6,8,12],[20,22,4]],"ru":"Горе молящимся,","tr":"Fa wai lul-lil mu salleen"},{"n":5,"ar":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","tj":[[17,18,9],[35,37,4]],"ru":"которые небрежны к своим намазам,","tr":"Al lazeena hum 'an salaatihim sahoon"},{"n":6,"ar":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","tj":[[18,20,5],[22,24,4]],"ru":"которые лицемерят","tr":"Al lazeena hum yuraa-oon"},{"n":7,"ar":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","tj":[[14,15,0],[21,23,4]],"ru":"и отказывают даже в мелочи!","tr":"Wa yamna'oonal ma'oon"}]}
