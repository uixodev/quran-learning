{"id":101,"ayahs":[{"n":1,"ar":"ٱلۡقَارِعَةُ","tj":[],"ru":"Великое бедствие (День воскресения)","tr":"AlqariAAatu"},{"n":2,"ar":"مَا ٱلۡقَارِعَةُ","tj":[[4,5,0]],"ru":"Что такое Великое бедствие (День воскресения)","tr":"Ma alqariAAatu"},{"n":3,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","tj":[[3,6,5],[9,11,7],[13,15,3],[22,23,0]],"ru":"Откуда ты мог знать, что такое Великое бедствие (День воскресения)","tr":"Wama adraka ma alqariAAatu"},{"n":4,"ar":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","tj":[[15,16,0],[16,17,1],[17,19,8],[26,27,0],[37,38,0],[42,44,7],[45,47,4]],"ru":"В тот день люди будут подобны рассеянным мотылькам","tr":"Yawma yakoonu alnnasu kaalfarashi almabthoothi"},{"n":5,"ar":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","tj":[[10,11,0],[23,24,0],[33,34,0],[38,40,9],[40,42,4]],"ru":"а горы будут подобны расчесанной шерсти","tr":"Watakoonu aljibalu kaalAAihni almanfooshi"},{"n":6,"ar":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","tj":[[4,6,8],[11,12,9],[25,27,3]],"ru":"Тогда тот, чья чаша Весов окажется тяжелой","tr":"Faamma man thaqulat mawazeenuhu"},{"n":7,"ar":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","tj":[[16,18,12]],"ru":"обретет приятную жизнь","tr":"Fahuwa fee AAeeshatin radiyatin"},{"n":8,"ar":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","tj":[[4,6,8],[25,27,3]],"ru":"Для того же, чья чаша Весов окажется легкой","tr":"Waamma man khaffat mawazeenuhu"},{"n":9,"ar":"فَأُمُّهُۥ هَاوِيَةٞ","tj":[[4,6,8],[9,10,3]],"ru":"матерью станет Пропасть (грешники будут искать убежище в Аду, подобно тому, как ребенок ищет убежище у своей матери; или грешники будут падать в Адскую Пропасть вниз головой)","tr":"Faommuhu hawiyatun"},{"n":10,"ar":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","tj":[[3,6,5],[9,11,7],[13,15,3]],"ru":"Откуда ты мог знать, что это такое","tr":"Wama adraka ma hiyah"},{"n":11,"ar":"نَارٌ حَامِيَةُۢ","tj":[],"ru":"Это - жаркий Огонь","tr":"Narun hamiyatun"}]}
