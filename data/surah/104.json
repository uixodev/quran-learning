{"id":104,"ayahs":[{"n":1,"ar":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","tj":[[4,6,12],[22,24,12]],"ru":"Горе всякому хулителю и обидчику","tr":"Waylun likulli humazatin lumazatin"},{"n":2,"ar":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","tj":[[22,23,11]],"ru":"который копит состояние и пересчитывает его","tr":"Allathee jamaAAa malan waAAaddadahu"},{"n":3,"ar":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","tj":[[11,13,8],[22,24,5]],"ru":"думая, что богатство увековечит его","tr":"Yahsabu anna malahu akhladahu"},{"n":4,"ar":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","tj":[[12,15,14],[18,20,8],[26,27,0]],"ru":"Но нет! Его непременно ввергнут в Огонь сокрушающий","tr":"Kalla layunbathanna fee alhutamati"},{"n":5,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","tj":[[3,6,5],[9,11,7],[13,15,3],[22,23,0]],"ru":"Откуда ты мог знать, что такое Огонь сокрушающий","tr":"Wama adraka ma alhutamatu"},{"n":6,"ar":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","tj":[[6,7,0],[14,15,0]],"ru":"Это - разожженный Огонь Аллаха","tr":"Naru Allahi almooqadatu"},{"n":7,"ar":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","tj":[[24,25,0]],"ru":"который вздымается над сердцами","tr":"Allatee tattaliAAu AAala alafidati"},{"n":8,"ar":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","tj":[[2,4,8],[19,20,13]],"ru":"Воистину, он сомкнется над ними","tr":"lnnaha AAalayhim musadatun"},{"n":9,"ar":"فِي عَمَدٖ مُّمَدَّدَةِۭ","tj":[[11,12,11]],"ru":"высокими столбами (мученики будут прикованы к этим столбам или врата Ада будут заперты и закреплены этими столбами)","tr":"Fee AAamadin mumaddadatin"}]}
