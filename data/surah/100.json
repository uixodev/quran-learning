{"id":100,"ayahs":[{"n":1,"ar":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا","tj":[[2,3,0],[7,8,3],[12,13,3],[18,20,7]],"ru":"Клянусь скачущими, запыхаясь","tr":"WaalAAadiyati dabhan"},{"n":2,"ar":"فَٱلۡمُورِيَٰتِ قَدۡحٗا","tj":[[2,3,0],[12,13,3],[18,20,7]],"ru":"Клянусь высекающими искры копытами","tr":"Faalmooriyati qadhan"},{"n":3,"ar":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا","tj":[[2,3,0],[11,13,3],[18,20,7]],"ru":"Клянусь нападающими на заре","tr":"Faalmugheerati subhan"},{"n":4,"ar":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا","tj":[[14,16,3],[19,21,7]],"ru":"Тем самым они поднимают столб пыли","tr":"Faatharna bihi naqAAan"},{"n":5,"ar":"فَوَسَطۡنَ بِهِۦ جَمۡعًا","tj":[[6,8,7],[14,16,3]],"ru":"и врываются с ним (со столбом пыли или с всадником) в гущу","tr":"Fawasatna bihi jamAAan"},{"n":6,"ar":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ","tj":[[2,4,8],[6,7,0],[11,14,9],[14,15,3],[26,28,3],[34,36,4],[36,37,7]],"ru":"Воистину, человек неблагодарен своему Господу","tr":"Inna alinsana lirabbihi lakanoodun"},{"n":7,"ar":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ","tj":[[4,6,8],[9,10,3],[19,21,3],[31,33,4],[33,34,7]],"ru":"и он сам является тому свидетелем","tr":"Wainnahu AAala thalika lashaheedun"},{"n":8,"ar":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ","tj":[[4,6,8],[9,10,3],[19,20,0],[34,36,4],[36,37,7]],"ru":"Воистину, он страстно любит блага","tr":"Wainnahu lihubbi alkhayri lashadeedun"},{"n":9,"ar":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ","tj":[[41,42,0],[47,49,4]],"ru":"Неужели он не знает, что, когда будет опрокинуто то, что в могилах","tr":"Afala yaAAlamu itha buAAthira ma fee alquboori"},{"n":10,"ar":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ","tj":[[18,19,0],[19,20,1],[24,26,4]],"ru":"и когда обнаружится то, что в груди","tr":"Wahussila ma fee alssudoori"},{"n":11,"ar":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ","tj":[[2,4,8],[12,14,10],[30,32,12],[39,41,4]],"ru":"в тот день Господь их будет осведомлен о них","tr":"Inna rabbahum bihim yawmaithin lakhabeerun"}]}
