{"id":80,"ayahs":[{"n":1,"ar":"عَبَسَ وَتَوَلَّىٰٓ","tj":[],"ru":"Он нахмурился и отвернулся","tr":"AAabasa watawalla"},{"n":2,"ar":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","tj":[[2,3,9],[5,7,5],[13,14,0]],"ru":"потому что к нему подошел слепой","tr":"An jaahu alaAAma"},{"n":3,"ar":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","tj":[[8,10,7],[25,26,3]],"ru":"Откуда тебе знать? Возможно, он бы очистился","tr":"Wama yudreeka laAAallahu yazzakka"},{"n":4,"ar":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","tj":[[20,22,9],[28,29,0],[29,30,1]],"ru":"или помянул бы наставление, и поминание принесло бы ему пользу","tr":"Aw yaththakkaru fatanfaAAahu alththikra"},{"n":5,"ar":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","tj":[[2,4,8],[12,13,0]],"ru":"Тому, кто решил, что он ни в чем не нуждается","tr":"Amma mani istaghna"},{"n":6,"ar":"فَأَنتَ لَهُۥ تَصَدَّىٰ","tj":[[4,6,9],[12,13,3]],"ru":"ты уделяешь внимание","tr":"Faanta lahu tasadda"},{"n":7,"ar":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","tj":[],"ru":"Что же будет тебе, если он не очистится","tr":"Wama AAalayka alla yazzakka"},{"n":8,"ar":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","tj":[[4,6,8],[11,12,9],[14,16,5]],"ru":"А того, кто приходит к тебе со рвением","tr":"Waamma man jaaka yasAAa"},{"n":9,"ar":"وَهُوَ يَخۡشَىٰ","tj":[],"ru":"и страшится Аллаха","tr":"Wahuwa yakhsha"},{"n":10,"ar":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","tj":[[4,6,9]],"ru":"ты оставляешь без внимания","tr":"Faanta AAanhu talahha"},{"n":11,"ar":"كَلَّآ إِنَّهَا تَذۡكِرَةٞ","tj":[[4,7,5],[10,12,8]],"ru":"Но нет! Это есть Назидание","tr":"Kalla innaha tathkiratun"},{"n":12,"ar":"فَمَن شَآءَ ذَكَرَهُۥ","tj":[[4,5,9],[7,9,5]],"ru":"и пусть помянет его всякий желающий","tr":"Faman shaa thakarahu"},{"n":13,"ar":"فِي صُحُفٖ مُّكَرَّمَةٖ","tj":[[11,12,11]],"ru":"Оно записано в свитках почитаемых","tr":"Fee suhufin mukarramatin"},{"n":14,"ar":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ","tj":[[13,14,11]],"ru":"вознесенных и очищенных","tr":"MarfooAAatin mutahharatin"},{"n":15,"ar":"بِأَيۡدِي سَفَرَةٖ","tj":[],"ru":"в руках посланцев","tr":"Biaydee safaratin"},{"n":16,"ar":"كِرَامِۭ بَرَرَةٖ","tj":[[5,8,14]],"ru":"благородных и покорных","tr":"Kiramin bararatin"},{"n":17,"ar":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ","tj":[[7,8,0],[12,15,9],[15,16,3],[20,23,5]],"ru":"Да сгинет человек! Как же он неблагодарен","tr":"Qutila alinsanu ma akfarahu"},{"n":18,"ar":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","tj":[],"ru":"Из чего Он сотворил его","tr":"Min ayyi shayin khalaqahu"},{"n":19,"ar":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","tj":[[4,7,11],[7,9,7],[22,23,3]],"ru":"Он сотворил его из капли и соразмерил (или предопределил стадии его развития)","tr":"Min nutfatin khalaqahu faqaddarahu"},{"n":20,"ar":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","tj":[[2,4,8],[6,7,0],[7,8,1]],"ru":"потом облегчил ему путь","tr":"Thumma alssabeela yassarahu"},{"n":21,"ar":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","tj":[[2,4,8],[15,16,3],[21,23,7]],"ru":"потом умертвил его и поместил в могилу","tr":"Thumma amatahu faaqbarahu"},{"n":22,"ar":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","tj":[[2,4,8],[13,15,5],[21,23,9]],"ru":"Потом, когда пожелает, Он воскресит его","tr":"Thumma itha shaa ansharahu"},{"n":23,"ar":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ","tj":[[9,11,8],[16,18,7],[22,25,5]],"ru":"Но нет! Он не выполняет того, что Он приказал ему","tr":"Kalla lamma yaqdi ma amarahu"},{"n":24,"ar":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","tj":[[6,8,9],[12,13,0],[17,20,9],[20,21,3]],"ru":"Пусть посмотрит человек на свое пропитание","tr":"Falyanthuri alinsanu ila taAAamihi"},{"n":25,"ar":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا","tj":[[2,4,8],[11,13,7],[17,18,0],[21,23,5]],"ru":"Мы проливаем обильные ливни","tr":"Anna sababna almaa sabban"},{"n":26,"ar":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا","tj":[[2,4,8],[10,12,7],[16,17,0]],"ru":"затем рассекаем землю трещинами","tr":"Thumma shaqaqna alarda shaqqan"},{"n":27,"ar":"فَأَنۢبَتۡنَا فِيهَا حَبّٗا","tj":[[4,7,14]],"ru":"и взращиваем на ней зерна","tr":"Faanbatna feeha habban"},{"n":28,"ar":"وَعِنَبٗا وَقَضۡبٗا","tj":[[10,11,11]],"ru":"виноград и люцерну","tr":"WaAAinaban waqadban"},{"n":29,"ar":"وَزَيۡتُونٗا وَنَخۡلٗا","tj":[[13,14,11]],"ru":"маслины и финиковые пальмы","tr":"Wazaytoonan wanakhlan"},{"n":30,"ar":"وَحَدَآئِقَ غُلۡبٗا","tj":[[5,7,5]],"ru":"сады густые (или с могучими деревьями)","tr":"Wahadaiqa ghulban"},{"n":31,"ar":"وَفَٰكِهَةٗ وَأَبّٗا","tj":[[4,5,3],[12,13,11]],"ru":"фрукты и травы","tr":"Wafakihatan waabban"},{"n":32,"ar":"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","tj":[[5,6,3],[6,9,12],[28,29,3]],"ru":"на пользу вам и вашей скотине","tr":"MataAAan lakum walianAAamikum"},{"n":33,"ar":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","tj":[[9,11,5],[17,18,0],[18,19,1],[21,23,6]],"ru":"Когда же раздастся Оглушительный глас","tr":"Faitha jaati alssakhkhatu"},{"n":34,"ar":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ","tj":[[15,16,0],[33,35,4]],"ru":"в тот день человек бросит своего брата","tr":"Yawma yafirru almaro min akheehi"},{"n":35,"ar":"وَأُمِّهِۦ وَأَبِيهِ","tj":[[4,6,8],[8,10,3],[16,18,4]],"ru":"свою мать и своего отца","tr":"Waommihi waabeehi"},{"n":36,"ar":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","tj":[[4,5,3],[12,14,3],[20,22,4]],"ru":"свою жену и своих сыновей","tr":"Wasahibatihi wabaneehi"},{"n":37,"ar":"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ","tj":[[8,9,0],[17,18,11],[35,37,9],[45,46,11],[50,52,4]],"ru":"ибо у каждого человека своих забот будет сполна","tr":"Likulli imriin minhum yawmaithin shanun yughneehi"},{"n":38,"ar":"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ","tj":[[8,9,11],[19,20,11]],"ru":"В тот день одни лица будут сиять","tr":"Wujoohun yawmaithin musfiratun"},{"n":39,"ar":"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ","tj":[[10,11,11],[17,19,7]],"ru":"смеяться и ликовать","tr":"Dahikatun mustabshiratun"},{"n":40,"ar":"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ","tj":[[10,11,11]],"ru":"На других же лицах в тот день будет прах","tr":"Wawujoohun yawmaithin AAalayha ghabaratun"},{"n":41,"ar":"تَرۡهَقُهَا قَتَرَةٌ","tj":[],"ru":"покрывающий их мраком","tr":"Tarhaquha qataratun"},{"n":42,"ar":"أُوْلَـٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","tj":[[2,4,2],[7,9,5],[19,20,0],[31,32,0]],"ru":"Это будут неверующие грешники","tr":"Olaika humu alkafaratu alfajaratu"}]}
