{"id":113,"ayahs":[{"n":1,"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","tj":[[21,22,0],[28,29,7]],"ru":"Скажи: «Прибегаю к защите Господа рассвета","tr":"Qul a'uzoo bi rabbil-falaq"},{"n":2,"ar":"مِن شَرِّ مَا خَلَقَ","tj":[[2,3,9],[18,19,7]],"ru":"от зла того, что Он сотворил,","tr":"Min sharri ma khalaq"},{"n":3,"ar":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","tj":[[4,5,9],[30,31,7]],"ru":"от зла мрака, когда он наступает,","tr":"Wa min sharri ghasiqin iza waqab"},{"n":4,"ar":"وَمِن شَرِّ ٱلنَّفَّـٰثَٰتِ فِي ٱلۡعُقَدِ","tj":[[4,5,9],[12,13,0],[13,14,1],[14,16,8],[21,22,3],[24,25,3],[32,33,0],[39,40,7]],"ru":"от зла колдуний, поплевывающих на узлы,","tr":"Wa min sharrin-naffaa-thaati fil 'uqad"},{"n":5,"ar":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","tj":[[4,5,9],[30,31,7]],"ru":"от зла завистника, когда он завидует».","tr":"Wa min shar ri haasidin iza hasad"}]}
