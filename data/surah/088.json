{"id":88,"ayahs":[{"n":1,"ar":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","tj":[[10,11,3],[22,23,0],[27,28,3]],"ru":"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)","tr":"Hal ataka hadeethu alghashiyati"},{"n":2,"ar":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","tj":[[8,9,11],[21,22,3]],"ru":"Одни лица в тот день будут унижены","tr":"Wujoohun yawmaithin khashiAAatun"},{"n":3,"ar":"عَامِلَةٞ نَّاصِبَةٞ","tj":[[10,11,11]],"ru":"изнурены и утомлены","tr":"AAamilatun nasibatun"},{"n":4,"ar":"تَصۡلَىٰ نَارًا حَامِيَةٗ","tj":[],"ru":"Они войдут в Огонь жаркий","tr":"Tasla naran hamiyatan"},{"n":5,"ar":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","tj":[],"ru":"Их будут поить из источника кипящего","tr":"Tusqa min AAaynin aniyatin"},{"n":6,"ar":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","tj":[[32,33,9],[37,39,4]],"ru":"и кормить только ядовитыми колючками","tr":"Laysa lahum taAAamun illa min dareeAAin"},{"n":7,"ar":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","tj":[[30,31,9],[33,35,4]],"ru":"от которых не поправляются и которые не утоляют голода","tr":"La yusminu wala yughnee min jooAAin"},{"n":8,"ar":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","tj":[[8,9,11],[19,20,11]],"ru":"Другие же лица в тот день будут радостны","tr":"Wujoohun yawmaithin naAAimatun"},{"n":9,"ar":"لِّسَعۡيِهَا رَاضِيَةٞ","tj":[],"ru":"Они будут довольны своими стараниями","tr":"LisaAAyiha radiyatun"},{"n":10,"ar":"فِي جَنَّةٍ عَالِيَةٖ","tj":[[6,8,8]],"ru":"в Вышних садах","tr":"Fee jannatin AAaliyatin"},{"n":11,"ar":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ","tj":[[23,24,3]],"ru":"Они не услышат там словоблудия","tr":"La tasmaAAu feeha laghiyatan"},{"n":12,"ar":"فِيهَا عَيۡنٞ جَارِيَةٞ","tj":[[11,13,9]],"ru":"Там есть источник текущий","tr":"Feeha AAaynun jariyatun"},{"n":13,"ar":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ","tj":[[14,15,11]],"ru":"Там воздвигнуты ложа","tr":"Feeha sururun marfooAAatun"},{"n":14,"ar":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ","tj":[[12,13,11]],"ru":"расставлены чаши","tr":"Waakwabun mawdooAAatun"},{"n":15,"ar":"وَنَمَارِقُ مَصۡفُوفَةٞ","tj":[],"ru":"разложены подушки","tr":"Wanamariqu masfoofatun"},{"n":16,"ar":"وَزَرَابِيُّ مَبۡثُوثَةٌ","tj":[[15,17,7]],"ru":"и разостланы ковры","tr":"Wazarabiyyu mabthoothatun"},{"n":17,"ar":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","tj":[[10,12,9],[25,26,0]],"ru":"Неужели они не видят, как созданы верблюды","tr":"Afala yanthuroona ila alibili kayfa khuliqat"},{"n":18,"ar":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","tj":[[8,9,0],[9,10,1],[14,16,5]],"ru":"как вознесено небо","tr":"Waila alssamai kayfa rufiAAat"},{"n":19,"ar":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","tj":[[8,9,0]],"ru":"как водружены горы","tr":"Waila aljibali kayfa nusibat"},{"n":20,"ar":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","tj":[[8,9,0]],"ru":"как распростерта земля","tr":"Waila alardi kayfa sutihat"},{"n":21,"ar":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ","tj":[[12,14,8],[16,19,5],[22,24,9]],"ru":"Наставляй же, ведь ты - наставник","tr":"Fathakkir innama anta muthakkirun"},{"n":22,"ar":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","tj":[[15,17,10]],"ru":"и ты не властен над ними","tr":"Lasta AAalayhim bimusaytirin"},{"n":23,"ar":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","tj":[[9,10,9]],"ru":"А тех, кто отвернется и не уверует","tr":"Illa man tawalla wakafara"},{"n":24,"ar":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","tj":[[14,15,0],[22,23,0],[33,34,0]],"ru":"Аллах подвергнет величайшим мучениям","tr":"FayuAAaththibuhu Allahu alAAathaba alakbara"},{"n":25,"ar":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","tj":[[2,4,8],[13,16,5]],"ru":"К Нам они вернутся","tr":"Inna ilayna iyabahum"},{"n":26,"ar":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","tj":[[2,4,8],[8,10,8]],"ru":"и затем Мы потребуем у них отчета","tr":"Thumma inna AAalayna hisabahum"}]}
