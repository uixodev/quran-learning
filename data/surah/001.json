{"id":1,"ayahs":[{"n":1,"ar":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","tj":[[7,8,0],[15,16,0],[16,17,1],[24,25,3],[28,29,0],[29,30,1],[34,36,4]],"ru":"Во имя Аллаха, Милостивого, Милосердного","tr":"Bismi Allahi alrrahmani alrraheemi"},{"n":2,"ar":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","tj":[[24,25,0],[29,30,3],[33,35,4]],"ru":"Хвала Аллаху, Господу миров","tr":"Alhamdu lillahi rabbi alAAalameena"},{"n":3,"ar":"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","tj":[[1,2,1],[9,10,3],[13,14,0],[14,15,1],[19,21,4]],"ru":"Милостивому, Милосердному","tr":"Alrrahmani alrraheemi"},{"n":4,"ar":"مَٰلِكِ يَوۡمِ ٱلدِّينِ","tj":[[2,3,3],[15,16,0],[16,17,1],[19,21,4]],"ru":"Властелину Дня воздаяния","tr":"Maliki yawmi alddeeni"},{"n":5,"ar":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ","tj":[[36,38,4]],"ru":"Тебе одному мы поклоняемся и Тебя одного молим о помощи","tr":"Iyyaka naAAbudu waiyyaka nastaAAeenu"},{"n":6,"ar":"ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","tj":[[9,10,0],[10,11,1],[15,17,3],[20,21,0],[30,32,4]],"ru":"Веди нас прямым путем","tr":"Ihdina alssirata almustaqeema"},{"n":7,"ar":"صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ","tj":[[3,5,3],[8,9,0],[47,48,0],[77,78,0],[78,79,1],[81,83,6],[86,88,4]],"ru":"путем тех, кого Ты облагодетельствовал, не тех, на кого пал гнев, и не заблудших","tr":"Sirata allatheena anAAamta AAalayhim ghayri almaghdoobi AAalayhim wala alddalleena"}]}
