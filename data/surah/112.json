{"id":112,"ayahs":[{"n":1,"ar":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","tj":[[10,11,0],[22,23,7]],"ru":"Скажи: «Он - Аллах Единый","tr":"Qul huwa Allahu ahadun"},{"n":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","tj":[[8,9,0],[9,10,1],[15,16,7]],"ru":"Аллах Самодостаточный","tr":"Allahu alssamadu"},{"n":3,"ar":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","tj":[[9,11,7],[24,26,7]],"ru":"Он не родил и не был рожден","tr":"Lam yalid walam yooladu"},{"n":4,"ar":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","tj":[[10,12,12],[18,19,3],[32,33,7]],"ru":"и нет никого равного Ему»","tr":"Walam yakun lahu kufuwan ahadun"}]}
